{"rules":{
 ".read":false,
 ".write":false,
 "users":{"$u":{
  ".read":"auth!=null",
  ".write":"auth.uid===$u",
  "name":{".validate":"newData.isString() && newData.val().length<=30"},
  "about":{".validate":"newData.isString() && newData.val().length<=80"},
  "photo":{".validate":"newData.isString() && newData.val().length<80000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"},
  "username":{".validate":"newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"},
  "online":{".validate":"newData.isBoolean()"},
  "lastSeen":{".validate":"newData.isNumber()"},
  "hideSeen":{".validate":"newData.isBoolean()"},
  "$other":{".validate":false}
 }},
 "usernames":{"$n":{
  ".read":"auth!=null",
  ".write":"auth!=null && (!data.exists() || data.val()===auth.uid) && (!newData.exists() || root.child('users').child(auth.uid).child('username').val()===$n)",
  ".validate":"newData.val()===auth.uid && $n.matches(/^[a-z0-9_]{3,20}$/)"
 }},
 "groups":{"$g":{
  ".read":"data.child('members').child(auth.uid).exists()",
  ".write":"!data.exists() && newData.child('admin').val()===auth.uid && newData.child('members').child(auth.uid).exists() && newData.child('members').numChildren()<=100",
  ".validate":"newData.hasChildren(['name','admin','members'])",
  "name":{".write":"data.parent().child('admin').val()===auth.uid",".validate":"newData.isString() && newData.val().length>0 && newData.val().length<=30"},
  "admin":{".validate":"newData.isString()"},
  "ts":{".validate":"newData.isNumber()"},
  "members":{"$m":{
   ".write":"data.parent().parent().child('admin').val()===auth.uid || ($m===auth.uid && !newData.exists())",
   ".validate":"newData.val()===true && root.child('users').child($m).exists()"
  }},
  "$other":{".validate":false}
 }},
 "signals":{"$to":{
  ".read":"auth.uid===$to",
  ".write":"auth.uid===$to",
  "$k":{
   ".write":"auth!=null && !data.exists() && root.child('users').child($to).exists()",
   ".validate":"newData.hasChildren(['from','data']) && newData.child('from').val()===auth.uid && newData.child('data').isString() && newData.child('data').val().length<20000",
   "from":{".validate":"newData.isString()"},
   "data":{".validate":"newData.isString()"},
   "$other":{".validate":false}
  }
 }}
}}
